{
  "name": "trendyhits",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "npx -y netlify-cli dev",
    "check:i18n": "node scripts/check-i18n.mjs",
