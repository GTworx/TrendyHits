# --- LLM (agents: trends orchestrator + newsletter) ---
GEMINI_API_KEY=
# Any Gemini model with Google Search grounding (e.g. gemini-2.5-flash, gemini-flash-latest)
AI_MODEL=gemini-flash-latest

# --- Kit (kit.com) API v4 ---
KIT_API_KEY=
# Base tag every subscriber receives (name or numeric ID)
KIT_TAG=TrendyHits
# Language tags (numeric IDs). If empty, "<KIT_TAG> TR" / "<KIT_TAG> EN" are looked up by name and created if missing.
KIT_TAG_ID_TR=
KIT_TAG_ID_EN=
# Optional: verified sender address for broadcasts
KIT_SENDER_EMAIL=

# --- Database (Postgres). Netlify DB sets NETLIFY_DATABASE_URL automatically. ---
# If neither is set, likes are stored in Netlify Blobs.
NETLIFY_DATABASE_URL=
DATABASE_URL=

# --- Newsletter agent ---
SITE_URL=https://your-site.netlify.app
